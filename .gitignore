# ============================================================
#  CAZADOR CAZADO — .gitignore
#  IMPORTANTE: Nunca subas datos de casos reales a Git.
# ============================================================

# ── Entorno virtual (cientos de MB, no versionar) ────────────────────────────
venv/
env/
.venv/
.env/

# ── DATOS CONFIDENCIALES ─────────────────────────────────────────────────────
# Carpetas con información de víctimas, acosadores y casos reales
data/
reports/

# Config del monitor automático (contiene usernames de víctimas)
data/monitor_config.json
run_monitor.py              # generado por setup_monitor.py, puede tener rutas locales

# Base de datos de twscrape (contiene cookies/tokens de Twitter)
*.db
accounts.db
twscrape.db

# IDs ya vistos (puede revelar qué cuentas se monitorizan)
**/seen_ids.json

# ── Logs (pueden contener datos de investigación) ────────────────────────────
activity.log
*.log
logs/

# ── Scripts de test con casos reales ─────────────────────────────────────────
# test_victim_watcher.py se puede subir (no tiene datos reales)
# Excluir solo scripts con nombres de casos específicos:
investigar_caso*.py
osint_profundo*.py
gen_report_v2.py
final_search.py

# ── Capturas y evidencias temporales ─────────────────────────────────────────
*.html
screenshots/
evidence/

# ── Caché de Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.pyc

# ── Variables de entorno y secretos ──────────────────────────────────────────
.env
.env.local
.env.production
*.env
config.local.yaml
secrets.yaml

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/

# ── Sistemas operativos ───────────────────────────────────────────────────────
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ── Archivos temporales ──────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.orig

# ── Distribución / empaquetado ───────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
